# ─────────────────────────────────────────────────────────────────────────
# RAVIO — переменные окружения для бэкенда /api/submit
#
# ЭТО ШАБЛОН. Реальные значения НЕ хранятся в коде и НЕ заливаются в GitHub.
# Их нужно вписать в Vercel: Project → Settings → Environment Variables.
# Файл .env.example можно держать в репозитории — в нём нет секретов.
# ─────────────────────────────────────────────────────────────────────────

# Telegram (получить новый токен у @BotFather → /token, СТАРЫЙ ОБЯЗАТЕЛЬНО ОТОЗВАТЬ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=799401432

# Google Sheets (URL веб-приложения Apps Script, doPost)
GOOGLE_SHEETS_URL=

# EmailJS (Private Key нужен для серверных вызовов:
#   EmailJS → Account → Security → включить "Allow EmailJS API for non-browser applications")
EMAILJS_SERVICE_ID=service_z0fmaxo
EMAILJS_TEMPLATE_ID=template_opxohip
EMAILJS_PUBLIC_KEY=E_3YAA754JvtVGrK7
EMAILJS_PRIVATE_KEY=
EMAILJS_TO_EMAIL=amdk55@yandex.ru

# Ограничение источника запросов (рекомендуется после привязки домена)
# Пример: https://calculator-ravio.kz
ALLOWED_ORIGIN=
